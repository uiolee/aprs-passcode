{
  "name": "aprs-passcode",
  "version": "0.1.0",
  "description": "a web tool to generate/calculate passcode of aprs for your casllsign.",
  "keywords": [
    "aprs",
    "passcode",
    "hamradio"
  ],
  "license": "MPL-2.0",
  "author": "uiolee (https://github.com/uiolee)",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "postbuild": "node ./scripts/minify-html.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vite dev",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "vite preview",
    "sortpkj": "pnpm dlx sort-package-json"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.4",
    "@inlang/paraglide-js": "^2.18.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.59.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^16.5.0",
    "htmlnano": "^2.1.5",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^7.3.2"
  }
}
